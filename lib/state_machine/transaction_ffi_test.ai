use("test")

let ref = import("state_machine/native")
let fast = import("state_machine/ffi")
let op = import("state_machine/ops")
let fixed_store = import("store/ffi")
let fixed = import("machine/ffi")

let transitions = [
	[0, 1, -1, 0, 0, 1, [
		[op.ADDR18_FROM_WORD, 0, 0, 0],
		[op.STAGE_WORD_ADDR18, 1, 0, 0],
		[op.LOAD_WORD_ADDR18, 2, 0, 0]
	], -1, -1],
	[1, 1, -1, 0, 0, 2, [
		[op.SET, 0, 3, 0],
		[op.ADDR18_FROM_WORD, 0, 0, 0],
		[op.STAGE_BYTE_ADDR18, 3, 0, 0],
		[op.LOAD_BYTE_ADDR18, 4, 0, 0],
		[op.SET, 0, 2, 0],
		[op.ADDR18_FROM_WORD, 0, 0, 0],
		[op.LOAD_WORD_ADDR18, 2, 0, 0]
	], -1, -1]
]


run("transactional provider matches reference overlay and commit", () {
	let rp = ref.compile(3, 5, 0, 0, transitions, 1)
	let fp = fast.compile(3, 5, 0, 0, transitions, 1)
	let native_backing = [0, 4660, 0, 0]
	let backing = fixed_store.new_word(4)
	fixed_store.set(backing, 1, fixed.word(4660))
	let initial = [2, 43981, 0, 238, 0]
	let rm = ref.new(rp, initial, [native_backing])
	let fm = fast.new(fp, initial, [backing])
	is_true(ref.step(rm, 1))
	is_true(fast.step(fm, 1))
	equal(fast.slot(fm, 2), ref.slot(rm, 2))
	equal(fast.staged_writes(fm), ref.staged_writes(rm))
	# Bound store remains unchanged before explicit commit.
	equal(fixed.number(fixed_store.get(backing, 1)), 4660)
	is_true(ref.step(rm, 1))
	is_true(fast.step(fm, 1))
	equal(fast.slot(fm, 2), ref.slot(rm, 2))
	equal(fast.slot(fm, 4), ref.slot(rm, 4))
	equal(fast.staged_writes(fm), 2)
	equal(fixed.number(fixed_store.get(backing, 1)), 4660)
	is_true(ref.commit_writes(rm))
	is_true(fast.commit_writes(fm))
	equal(fast.staged_writes(fm), 0)
	equal(fixed.number(fixed_store.get(backing, 1)), 61133)
})


run("transactional provider discard leaves bound store untouched", () {
	let fp = fast.compile(3, 5, 0, 0, transitions, 1)
	let backing = fixed_store.new_word(4)
	fixed_store.set(backing, 1, fixed.word(4660))
	let fm = fast.new(fp, [2, 43981, 0, 238, 0], [backing])
	is_true(fast.step(fm, 1))
	equal(fast.staged_writes(fm), 1)
	is_true(fast.discard_writes(fm))
	equal(fast.staged_writes(fm), 0)
	equal(fixed.number(fixed_store.get(backing, 1)), 4660)
})
