use("test")
let ref = import("state_machine/native")
let fast = import("state_machine/ffi")

# Two-state neutral machine. Event 1 alternates states and increments slot 0.
# The first four transitions emit exact boundary observations into a bounded ring.
let transitions = [
	[0, 1, -1, 0, 1, [[1, 0, 1]], 10, 0],
	[1, 1, -1, 0, 0, [[1, 0, 1]], 11, 0]
]


run("intrinsic matches reference state slots and outputs", () {
	let rp = ref.compile(2, 1, 0, 8, transitions)
	let fp = fast.compile(2, 1, 0, 8, transitions)
	let rm = ref.new(rp, [0])
	let fm = fast.new(fp, [0])
	let i = 0
	while i < 4 {
		is_true(ref.step(rm, 1))
		is_true(fast.step(fm, 1))
		i = i + 1
	}
	equal(fast.state(fm), ref.state(rm))
	equal(fast.slot(fm, 0), ref.slot(rm, 0))
	equal(fast.outputs(fm), ref.outputs(rm))
	equal(fast.dropped(fm), ref.dropped(rm))
})


run("intrinsic guard and set are parity checked", () {
	let guarded = [
		[0, 7, 0, 3, 1, [[0, 1, 42]], -1, -1]
	]
	let rp = ref.compile(2, 2, 0, 0, guarded)
	let fp = fast.compile(2, 2, 0, 0, guarded)
	let rm = ref.new(rp, [3, 0])
	let fm = fast.new(fp, [3, 0])
	is_true(ref.step(rm, 7))
	is_true(fast.step(fm, 7))
	equal(fast.state(fm), ref.state(rm))
	equal(fast.slot(fm, 1), 42)
	equal(fast.slot(fm, 1), ref.slot(rm, 1))
})


run("bounded output drops rather than blocks or grows", () {
	let p = fast.compile(2, 1, 0, 2, transitions)
	let m = fast.new(p, [0])
	equal(fast.run(m, 1, 5), 5)
	equal(fast.outputs(m), [[10, 1], [11, 2]])
	equal(fast.dropped(m), 3)
})


run("invalid admitted programs are rejected", () {
	faults(() {
		fast.compile(0, 1, 0, 0, [])
	})
	faults(() {
		fast.compile(2, 1, 2, 0, [])
	})
	faults(() {
		fast.compile(2, 1, 0, 0, [[0, 1, -1, 0, 2, [], -1, -1]])
	})
	faults(() {
		fast.compile(2, 1, 0, 0, [[0, 1, -1, 0, 1, [[1, 4, 1]], -1, -1]])
	})
})


run("masked guards and run_until are parity checked", () {
	let masked = [
		[0, 1, 0, 240, 160, 1, [[0, 1, 7]], -1, -1],
		[1, 1, -1, 0, 0, 2, [[1, 1, 1]], -1, -1]
	]
	let rp = ref.compile(3, 2, 0, 0, masked)
	let fp = fast.compile(3, 2, 0, 0, masked)
	let rm = ref.new(rp, [175, 0])
	let fm = fast.new(fp, [175, 0])
	equal(ref.run_until(rm, 1, 10, 2), fast.run_until(fm, 1, 10, 2))
	equal(fast.state(fm), 2)
	equal(fast.slot(fm, 1), 8)
	equal(fast.slot(fm, 1), ref.slot(rm, 1))
})


run("bound word-store load and fixed slot ops are parity checked", () {
	let fixed_store = import("store/ffi")
	let fixed = import("machine/ffi")
	let native_backing = [0, 0, 4660, 0]
	let backing = fixed_store.new_word(4)
	fixed_store.set(backing, 2, fixed.word(4660))
	let ops = [
		[2, 1, 0, 0],
		[7, 1, 1, 0],
		[8, 2, 0, 1],
		[3, 2, 255, 0],
		[4, 2, 256, 0]
	]
	let t = [[0, 1, -1, 0, 0, 1, ops, -1, -1]]
	let rp = ref.compile(2, 3, 0, 0, t)
	let fp = fast.compile(2, 3, 0, 0, t)
	let rm = ref.new(rp, [4, 0, 0], [native_backing])
	let fm = fast.new(fp, [4, 0, 0], [backing])
	is_true(ref.step(rm, 1))
	is_true(fast.step(fm, 1))
	equal(fast.slot(fm, 1), ref.slot(rm, 1))
	equal(fast.slot(fm, 2), ref.slot(rm, 2))
})
