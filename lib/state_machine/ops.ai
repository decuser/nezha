package "state_machine/ops"

# Generic fixed-state-machine operation ids. These describe runtime mechanism,
# never guest-machine instruction semantics. Keep this table aligned with the
# provider enum in builtins_state_machine_ffi.go.
let SET = 0
let ADD_CONST = 1
let COPY = 2
let AND_CONST = 3
let OR_CONST = 4
let XOR_CONST = 5
let SHL_CONST = 6
let SHR_CONST = 7
let LOAD_WORD = 8
let STORE_WORD = 9

# Separate 18-bit address scratch bank. Architectural word slots remain 16-bit.
let ADDR18_FROM_WORD = 10
let ADDR18_SHL = 11
let ADDR18_ADD_WORD = 12
let LOAD_WORD_ADDR18 = 13

# Neutral 16-bit slot-to-slot ALU and predicates.
let ADD_WORD = 14
let SUB_WORD = 15
let AND_WORD = 16
let OR_WORD = 17
let XOR_WORD = 18
let ADD_CARRY_WORD = 19
let SUB_BORROW_WORD = 20
let ADD_OVERFLOW_WORD = 21
let SUB_OVERFLOW_WORD = 22

# Transactional bound-store access. Staged writes are machine-local until an
# explicit commit; addr18 loads observe the staged overlay.
let STAGE_WORD_ADDR18 = 23
let STAGE_BYTE_ADDR18 = 24
let LOAD_BYTE_ADDR18 = 25

export(
	:SET,
	:ADD_CONST,
	:COPY,
	:AND_CONST,
	:OR_CONST,
	:XOR_CONST,
	:SHL_CONST,
	:SHR_CONST,
	:LOAD_WORD,
	:STORE_WORD,
	:ADDR18_FROM_WORD,
	:ADDR18_SHL,
	:ADDR18_ADD_WORD,
	:LOAD_WORD_ADDR18,
	:ADD_WORD,
	:SUB_WORD,
	:AND_WORD,
	:OR_WORD,
	:XOR_WORD,
	:ADD_CARRY_WORD,
	:SUB_BORROW_WORD,
	:ADD_OVERFLOW_WORD,
	:SUB_OVERFLOW_WORD,
	:STAGE_WORD_ADDR18,
	:STAGE_BYTE_ADDR18,
	:LOAD_BYTE_ADDR18
)
