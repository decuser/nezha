use("test")

let sm = import("state_machine/native")
let op = import("state_machine/ops")
let list = import("list")

# Generic addr18 op ids. They are state-machine mechanism, not PDP semantics.
run("addr18 scratch reaches bound word store above 16-bit byte address", () {
	# Physical byte address 0200000 is beyond the 16-bit virtual-address range.
	# Using range as the reference binding makes backing[index] == index without
	# constructing an additional 32K-element fixture.
	let backing = list.range(0, 32769)
	let transitions = [[
		0,
		1,
		-1,
		0,
		1,
		[
			[op.ADDR18_FROM_WORD, 0, 0, 0],
			[op.ADDR18_SHL, 0, 6, 0],
			[op.ADDR18_ADD_WORD, 0, 0, 1],
			[op.LOAD_WORD_ADDR18, 2, 0, 0]
		],
		-1,
		-1
	]]
	let p = sm.compile(2, 3, 0, 0, transitions, 1)
	let m = sm.new(p, [1024, 0, 0], [backing])
	is_true(sm.step(m, 1))
	equal(sm.slot(m, 2), 32768)
})


run("addr18 scratch does not widen architectural word slots", () {
	let transitions = [[
		0,
		1,
		-1,
		0,
		1,
		[
			[op.ADD_CONST, 0, 1],
			[op.ADDR18_FROM_WORD, 0, 0, 1],
			[op.ADDR18_SHL, 0, 6, 0]
		],
		-1,
		-1
	]]
	let p = sm.compile(2, 2, 0, 0, transitions, 1)
	let m = sm.new(p, [65535, 1024])
	is_true(sm.step(m, 1))
	# Existing word arithmetic still wraps at 16 bits.
	equal(sm.slot(m, 0), 0)
})


run("native compile rejects invalid addr18 operands", () {
	let bad_wide = [[0, 1, -1, 0, 1, [[op.ADDR18_FROM_WORD, 1, 0, 0]], -1, -1]]
	is_true(is_error(sm.compile(2, 1, 0, 0, bad_wide, 1)))
	let bad_source = [[0, 1, -1, 0, 1, [[op.ADDR18_ADD_WORD, 0, 0, 1]], -1, -1]]
	is_true(is_error(sm.compile(2, 1, 0, 0, bad_source, 1)))
	let bad_shift = [[0, 1, -1, 0, 1, [[op.ADDR18_SHL, 0, 32, 0]], -1, -1]]
	is_true(is_error(sm.compile(2, 1, 0, 0, bad_shift, 1)))
})
