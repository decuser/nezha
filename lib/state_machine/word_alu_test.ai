use("test")

let sm = import("state_machine/native")
let op = import("state_machine/ops")

let evaluate = (left, right) {
	let ops = [
		[op.ADD_WORD, 2, 0, 1],
		[op.SUB_WORD, 3, 0, 1],
		[op.AND_WORD, 4, 0, 1],
		[op.OR_WORD, 5, 0, 1],
		[op.XOR_WORD, 6, 0, 1],
		[op.ADD_CARRY_WORD, 7, 0, 1],
		[op.SUB_BORROW_WORD, 8, 0, 1],
		[op.ADD_OVERFLOW_WORD, 9, 0, 1],
		[op.SUB_OVERFLOW_WORD, 10, 0, 1]
	]
	let transitions = [[0, 1, -1, 0, 1, ops, -1, -1]]
	let p = sm.compile(2, 11, 0, 0, transitions)
	let m = sm.new(p, [left, right, 0, 0, 0, 0, 0, 0, 0, 0, 0])
	is_true(sm.step(m, 1))
	return [
		sm.slot(m, 2),
		sm.slot(m, 3),
		sm.slot(m, 4),
		sm.slot(m, 5),
		sm.slot(m, 6),
		sm.slot(m, 7),
		sm.slot(m, 8),
		sm.slot(m, 9),
		sm.slot(m, 10)
	]
}

run("word ALU arithmetic logic and neutral flag predicates", () {
	equal(evaluate(1, 2), [3, 65535, 0, 3, 3, 0, 1, 0, 0])
	equal(evaluate(65535, 1), [0, 65534, 1, 65535, 65534, 1, 0, 0, 0])
	equal(evaluate(32767, 1), [32768, 32766, 1, 32767, 32766, 0, 0, 1, 0])
	equal(evaluate(32768, 1), [32769, 32767, 0, 32769, 32769, 0, 0, 0, 1])
	equal(evaluate(32768, 65535), [32767, 32769, 32768, 65535, 32767, 1, 1, 1, 0])
})


run("native compile rejects invalid word ALU operands", () {
	let bad = [[0, 1, -1, 0, 1, [[op.SUB_WORD, 0, 0, 2]], -1, -1]]
	is_true(is_error(sm.compile(2, 2, 0, 0, bad)))
})
