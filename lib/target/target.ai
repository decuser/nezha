package "target"

# Shared CLI filesystem target resolution. Target interpretation, recursive
# traversal, ordering/deduplication, and .aikiignore policy live here; callers
# retain source-kind and command semantics.
let _file = import("file")
let _path = import("path")
let _string = import("string")
let _list = import("list")

let _contains = (xs, x) {
	let i = 0
	while i < length(xs) {
		if equal(xs[i], x) {
			return true
		}
		i = i + 1
	}
	return false
}

let _display = (base, p) {
	let b = _path.normalize(base)
	let q = _path.normalize(p)
	if equal(q, b) {
		return "."
	}
	let prefix = b + _path.separator()
	if _string.starts_with(q, prefix) {
		return _string.substring(q, length(prefix), length(q))
	}
	return q
}

let _absolute = (base, p) {
	if _path.is_absolute(p) {
		return _path.normalize(p)
	}
	return _path.normalize(_path.join(base, p))
}

let _recursive = (target) {
	equal(target, "...") or _string.ends_with(target, "/...") or _string.ends_with(target, _path.separator() + "...")
}

let _recursive_root = (target) {
	if equal(target, "...") {
		return "."
	}
	let n = length(target) - 4
	if n <= 0 {
		return "."
	}
	return _string.substring(target, 0, n)
}

let _policy_file = (base) {
	let current = _path.normalize(base)
	while true {
		let candidate = _path.join(current, ".aikiignore")
		if _file.exists(candidate) {
			return candidate
		}
		let parent = _path.dir(current)
		if equal(parent, "") or equal(parent, current) {
			return ""
		}
		current = parent
	}
}

let _policy_rules = (base, tool) {
	let policy = _policy_file(base)
	if equal(policy, "") {
		return [@policy, "", []]
	}
	let text = _file.read_all(policy)
	if is_error(text) {
		return text
	}
	let section = ""
	let rules = []
	let lines = _string.split(text, "\n")
	let i = 0
	while i < length(lines) {
		let line = _string.trim(lines[i])
		if (not equal(line, "")) and (not _string.starts_with(line, "#")) {
			if _string.starts_with(line, "[") and _string.ends_with(line, "]") {
				section = _string.trim(_string.substring(line, 1, length(line) - 1))
			} else {
				if equal(section, "all") or equal(section, tool) {
					rules = append(rules, line)
				}
			}
		}
		i = i + 1
	}
	return [@policy, _path.dir(policy), rules]
}

# Deliberately small first policy language: exact repository-relative paths and
# subtree prefixes written as path/**. This covers repository target selection
# without importing Git-ignore semantics.
let _rule_matches = (rule, rel, is_dir) {
	let r = _string.replace(rule, "\\", "/")
	let p = _string.replace(rel, "\\", "/")
	if equal(r, "**/.*") {
		let parts = _string.split(p, "/")
		let i = 0
		while i < length(parts) {
			if _string.starts_with(parts[i], ".") {
				return true
			}
			i = i + 1
		}
		return false
	}
	if _string.ends_with(r, "/**") {
		let prefix = _string.substring(r, 0, length(r) - 3)
		return equal(p, prefix) or _string.starts_with(p, prefix + "/")
	}
	return equal(p, r)
}

let _ignored = (policy_root, rules, path, is_dir) {
	if equal(policy_root, "") {
		return false
	}
	let rel = _display(policy_root, path)
	let i = 0
	while i < length(rules) {
		if _rule_matches(rules[i], rel, is_dir) {
			return true
		}
		i = i + 1
	}
	return false
}

let _walk = (root, policy_root, rules, bypass_policy, out, excluded) {
	let entries = _file.entries(root)
	if is_error(entries) {
		return entries
	}
	let i = 0
	while i < length(entries) {
		let entry = entries[i]
		let p = _path.join(root, entry[0])
		let is_dir = entry[1]
		if (not bypass_policy) and _ignored(policy_root, rules, p, is_dir) {
			excluded = append(excluded, [@target, p, :policy])
		} else {
			if is_dir {
				let child = _walk(p, policy_root, rules, bypass_policy, out, excluded)
				if is_error(child) {
					return child
				}
				out = child[0]
				excluded = child[1]
			} else {
				out = append(out, p)
			}
		}
		i = i + 1
	}
	return [@walk, out, excluded]
}

# resolve(base, tool, targets, recurse_plain_dirs)
# -> [@targets, paths, excluded]
# Paths are deterministic and deduplicated. Policy applies to discovered paths;
# a user target rooted inside an ignored subtree bypasses policy for that target.
let _resolve = (base, tool, targets, recurse_plain_dirs, include_ignored) {
	let policy = _policy_rules(base, tool)
	if is_error(policy) {
		return policy
	}
	let policy_root = policy[0]
	let rules = policy[1]
	let out = []
	let excluded = []
	let seen = []
	let ti = 0
	while ti < length(targets) {
		let original = targets[ti]
		let recursive = _recursive(original)
		let named = original
		if recursive {
			named = _recursive_root(original)
		}
		let root = _absolute(base, named)
		let st = _file.stat(root)
		if is_error(st) {
			return [@error, :target, "cannot find target: " + original]
		}
		let is_dir = st[2]
		let bypass_policy = include_ignored or _ignored(policy_root, rules, root, is_dir)
		if is_dir and (recursive or recurse_plain_dirs) {
			let walked = _walk(root, policy_root, rules, bypass_policy, [], [])
			if is_error(walked) {
				return walked
			}
			let files = walked[0]
			let wi = 0
			while wi < length(files) {
				let identity = _path.normalize(files[wi])
				if not _contains(seen, identity) {
					seen = append(seen, identity)
					out = append(out, _display(base, identity))
				}
				wi = wi + 1
			}
			excluded = _list.concat(excluded, walked[1])
		} else {
			if is_dir {
				return [@error, :target, "directory target requires recursion: " + original]
			}
			let identity = _path.normalize(root)
			if not _contains(seen, identity) {
				seen = append(seen, identity)
				out = append(out, _display(base, identity))
			}
		}
		ti = ti + 1
	}
	out = _list.sort(out)
	return [@targets, out, excluded]
}

let resolve = (base, tool, targets, recurse_plain_dirs) {
	return _resolve(base, tool, targets, recurse_plain_dirs, false)
}

let resolve_all = (base, tool, targets, recurse_plain_dirs) {
	return _resolve(base, tool, targets, recurse_plain_dirs, true)
}

export(:resolve, :resolve_all)
