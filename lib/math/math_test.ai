use("test")
use("math/ffi")
let approx = import("math/approx")

# floor - normal, boundary, error
run("floor rounds toward negative infinity", () {
	equal(floor(2.7), 2)
	equal(floor(2.0), 2)
	equal(floor(-2.7), -3)
	equal(floor(-2.0), -2)
})


run("floor at zero", () {
	equal(floor(0), 0)
})


run("floor on integers is identity", () {
	equal(floor(3), 3)
	equal(floor(-3), -3)
})


run("floor rejects non-number", () {
	faults(() {
		floor("abc")
	})
	faults(() {
		floor(:foo)
	})
})


# ceil - normal, boundary, error
run("ceil rounds toward positive infinity", () {
	equal(ceil(2.3), 3)
	equal(ceil(2.0), 2)
	equal(ceil(-2.7), -2)
	equal(ceil(-2.0), -2)
})


run("ceil at zero", () {
	equal(ceil(0), 0)
})


run("ceil on integers is identity", () {
	equal(ceil(3), 3)
	equal(ceil(-3), -3)
})


run("ceil rejects non-number", () {
	faults(() {
		ceil("abc")
	})
})


# truncate - normal, boundary, error
run("truncate rounds toward zero", () {
	equal(truncate(2.7), 2)
	equal(truncate(-2.7), -2)
	equal(truncate(2.0), 2)
})


run("truncate at zero", () {
	equal(truncate(0), 0)
})


run("truncate rejects non-number", () {
	faults(() {
		truncate("abc")
	})
})


# modulo - normal, boundary, error
run("modulo computes euclidean remainder", () {
	equal(modulo(10, 3), 1)
	equal(modulo(7, 7), 0)
	equal(modulo(0, 5), 0)
})


run("modulo with negative dividend", () {
	equal(modulo(-10, 3), 2)
	equal(modulo(-1, 3), 2)
})


run("modulo with negative divisor", () {
	equal(modulo(10, -3), 1)
})


run("modulo rejects division by zero", () {
	faults(() {
		modulo(10, 0)
	})
})


run("modulo rejects non-number", () {
	faults(() {
		modulo("a", 1)
	})
})


# sqrt - normal, boundary
run("sqrt of perfect squares is exact", () {
	equal(approx.sqrt(4), 2)
	equal(approx.sqrt(9), 3)
	equal(approx.sqrt(1), 1)
})


run("sqrt of zero", () {
	equal(approx.sqrt(0), 0)
})


# sin/cos - known values
run("sin at zero", () {
	equal(approx.sin(0), 0)
})


run("cos at zero", () {
	equal(approx.cos(0), 1)
})


run("sin faults on out-of-range argument", () {
	# A number too large for float64 must fault, not crash
	# float64 max is ~1.8e308, so 10^400 is safely beyond
	let huge = 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10
	let huge = huge * huge * huge * huge
	let huge = huge * huge * huge * huge * huge * huge * huge * huge * huge * huge
	faults(() {
		approx.sin(huge)
	})
})


run("cos faults on out-of-range argument", () {
	let huge = 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10
	let huge = huge * huge * huge * huge
	let huge = huge * huge * huge * huge * huge * huge * huge * huge * huge * huge
	faults(() {
		approx.cos(huge)
	})
})


run("sqrt faults on out-of-range argument", () {
	let huge = 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10
	let huge = huge * huge * huge * huge
	let huge = huge * huge * huge * huge * huge * huge * huge * huge * huge * huge
	faults(() {
		approx.sqrt(huge)
	})
})


run("sqrt faults on negative via Sign check", () {
	faults(() {
		approx.sqrt(-4)
	})
	faults(() {
		approx.sqrt(-1/1000000)
	})
})
