package "math/approx"

# math/approx - approximate numerical services
# These operations deliberately provide approximate numerical results. Their
# contract does not expose or promise any particular host numeric representation.
let sin = (x) {
	_sin_inexact(x)
}

let cos = (x) {
	_cos_inexact(x)
}

let sqrt = (x) {
	_sqrt_inexact(x)
}

export(:sin, :cos, :sqrt)
