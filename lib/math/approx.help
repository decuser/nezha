@summary "math/approx - approximate numerical services"

@func sin
@template "sin(x)"
@help "Returns an approximation of the sine of x in radians."

@func cos
@template "cos(x)"
@help "Returns an approximation of the cosine of x in radians."

@func sqrt
@template "sqrt(x)"
@help "Returns an approximation of the square root of x."
