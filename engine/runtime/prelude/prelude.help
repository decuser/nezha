@func apply
@template "apply(fn, args)"
@help "Call fn with the arguments in args."

@func print
@template "print(...args)"
@help "Write values without adding a newline."

@func println
@template "println(...args)"
@help "Write values and then a newline."

@func first
@template "first(list)"
@help "Return the first list element."

@func rest
@template "rest(list)"
@help "Return the list without its first element."

@func length
@template "length(list)"
@help "Return the list length."

@func prepend
@template "prepend(list, val)"
@help "Return list with val at the front."

@func append
@template "append(list, val)"
@help "Return list with val at the end."

@func empty
@template "empty(list)"
@help "Return true when list has no elements."

@func type
@template "type(val)"
@help "Return the value type as a symbol."

@func equal
@template "equal(a, b)"
@help "Return true when two values are equal."

@func shape
@template "shape(val)"
@help "Return a shaped list's shape, or :list."

@func is_error
@template "is_error(val)"
@help "Return true when val has shape :error."

@func to_str
@template "to_str(val)"
@help "Convert a value to a string."

@func shaped
@template "shaped(sym, elements)"
@help "Construct a shaped list."

@func abs
@template "abs(x)"
@help "Return the absolute value of x."
