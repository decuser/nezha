apply
Applies a function to a list of arguments.

apply(fn, args)

let add = (a, b) { a + b }
apply(add, [1, 2])  # 3
===
print
@unchecked
Writes values to stdout without newline.

print(val, ...)

print("hello")
===
println
@unchecked
Writes values to stdout followed by newline.

println(val, ...)

println("Hello")
===
first
Returns the first element of a list.

first(list)

first([1, 2, 3])      # 1
===
rest
Returns a new list without the first element.

rest(list)

rest([1, 2, 3])       # [2, 3]
===
length
Returns the number of elements in a list.

length(list)

length([1, 2, 3])     # 3
length([])            # 0
===
prepend
Returns a new list with the value at the front.

prepend(list, val)

prepend([2, 3], 1)    # [1, 2, 3]
===
append
Returns a new list with the value at the end.

append(list, val)

append([1, 2], 3)     # [1, 2, 3]
===
empty
Returns true if the list has no elements.

empty(list)

empty([])             # true
empty([1])            # false
===
abs
Returns the absolute value of a number.

abs(n)

abs(-5)    # 5
abs(3)     # 3
abs(0)     # 0
===
type
Returns the type of a value as a symbol.

type(val)

type(42)              # :number
type("hi")            # :string
type([1, 2])          # :list
type(true)            # :boolean
===
equal
Returns true if two values are equal.

equal(a, b)

equal(1, 1)           # true
equal(1, 2)           # false
equal([1], [1])       # false
===
shape
Returns the shape of a list, or :list for an unshaped list.

shape(val)

let @point [x, y]
shape([@point, 1, 2]) # :point
shape([1, 2])         # :list
===
is_error
Returns true if val is a shaped error.

is_error(val)

is_error([@error, "x"]) # true
is_error([1, 2])        # false
===
to_str
@unchecked
Converts a value to a string.

to_str(val)

to_str(42)           # "42"
to_str(true)         # "true"
to_str(:ok)          # ":ok"
===
shaped
@unchecked
Constructs a shaped list.

shaped(sym, elements)

shaped(:point, [1, 2]) # [@point, 1, 2]
