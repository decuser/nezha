# Prelude - minimal core
# This file has explicit runtime authority for only the _prefixed primitives it uses.
# Only evaluator-privileged and irreducible primitives belong here.
# Evaluator-privileged intrinsics
let apply = (fn, args) {
	_apply(fn, args)
}

# I/O (irreducible)
let print = (...args) {
	apply(_print, args)
}

let println = (...args) {
	apply(_print, args)
	_print("\n")
}

let read = () {
	_read()
}

# List intrinsics (wrappers over _ builtins)
let first = (list) {
	_first(list)
}

let rest = (list) {
	_rest(list)
}

let length = (list) {
	_length(list)
}

let prepend = (list, val) {
	_prepend(list, val)
}

let append = (list, val) {
	_append(list, val)
}

let empty = (list) {
	_empty(list)
}

# Type system intrinsics
let type = (val) {
	_type(val)
}

let equal = (a, b) {
	_equal(a, b)
}

let shape = (val) {
	_shape(val)
}

let is_error = (val) {
	_equal(_shape(val), :error)
}

let to_str = (val) {
	_to_str(val)
}

let shaped = (sym, elements) {
	_make_shaped_list(sym, elements)
}

let abs = (x) {
	if x < 0 {
		0 - x
	} else {
		x
	}
}
