# Build a Korean greeting from code points
let concat = (a, b) {
	let result = a
	let i = 0
	while i < length(b) {
		result = append(result, b[i])
		i = i + 1
	}
	return result
}

let annyeong = concat([chr(50504), chr(45397)], [chr(54616), chr(49464), chr(50836)])

# Print it
let i = 0
while i < length(annyeong) {
	print(annyeong[i])
	i = i + 1
}

println("")

# Round-trip check
println(ord(chr(50504)))

# Build and print 안녕
println(concat([chr(50504)], [chr(45397)]))
