# Host-math binary-carrier realization witness.
#
#     aiki profile --counts engineering/profiling/adaptive-number-host-math.ai
#
# Use math/approx explicitly: this workload crosses the provider-backed
# approximation boundary. Call-return realization should therefore show
# binary carriers. Arithmetic realization is measured separately.
#
# The loop deliberately performs carrier/carrier operations:
#
#     x + y       usually requires exact fallback when rounding would occur
#     x * half    certifiably exact for ordinary finite x
#     x - x       certifiably exact zero
#
# No operation is permitted to accept a rounded result as exact Aiki arithmetic.
let math = import("math/approx")

let half = math.sqrt(0.25)
let i = 0
let last = 0

while i < 100000 {
	let x = math.sin(i)
	let y = math.cos(i)
	let sum = x + y
	let scaled = x * half
	last = x - x
	i = i + 1
}

println(last)
