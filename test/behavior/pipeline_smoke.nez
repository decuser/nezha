# 1. Atomic tools
let range = (start, stop) {
	let result = []
	let i = start
	while i < stop {
		result = append(result, i)
		i = i + 1
	}
	return result
}

let filter = (xs, f) {
	let result = []
	let i = 0
	while i < length(xs) {
		if f(xs[i]) {
			result = append(result, xs[i])
		}
		i = i + 1
	}
	return result
}

let map = (xs, f) {
	let result = []
	let i = 0
	while i < length(xs) {
		result = append(result, f(xs[i]))
		i = i + 1
	}
	return result
}

let sum = (xs) {
	let total = 0
	let i = 0
	while i < length(xs) {
		total = total + xs[i]
		i = i + 1
	}
	return total
}

let square = (x) {
	return x * x
}

let is_even = (x) {
	return equal(x, 2) or equal(x, 4) or equal(x, 6) or equal(x, 8) or equal(x, 10)
}

print("PIPELINE\n")

range(1, 11) |>
filter(is_even) |>
map(square) |>
sum() |>
print("\n")


print("PIPELINE_SMOKE_DONE\n")
