# to_str smoke test - verify value conversion (not display formatting)
# Rune to string - should be "A" not "'A'"
println(to_str('A'))

# String unchanged
println(to_str("hello"))

# Number
println(to_str(42))
println(to_str(1/3))

# Boolean
println(to_str(true))
println(to_str(false))

# Symbol (keeps colon)
println(to_str(:foo))

# Build string from runes
let letters = ['h', 'e', 'l', 'l', 'o']
let s = ""
let i = 0
while i < length(letters) {
	s = s + to_str(letters[i])
	i = i + 1
}

println(s)

println("TO_STR_SMOKE_DONE")
