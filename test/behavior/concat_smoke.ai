# concat smoke test
let concat = (a, b) {
	let result = a
	let i = 0
	while i < length(b) {
		result = append(result, b[i])
		i = i + 1
	}
	return result
}

println(concat([1, 2], [3, 4]))
println(concat([], [1, 2]))
println(concat([1], []))
println(concat([], []))
println(length(concat([1, 2, 3], [4, 5])))
println("CONCAT_SMOKE_DONE")
