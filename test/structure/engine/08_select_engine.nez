# 08_select_engine.nez
# Select syntax remains in the grammar, but concurrency prelude bindings are removed.
# Keep coverage inside an uncalled function so evaluation does not require channels.
let dormant_select = (ch) {
	select {
		recv(ch) {
			println(:never)
		}
		default {
			println(:idle)
		}
	}
}

println(:select_syntax_covered)
